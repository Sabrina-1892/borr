{
  "regions": ["bom1"],
  "headers": [
    {
      "source": "/search",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/paper/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
